  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Bridged",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/dmxweb/dmxweb.go",
      "cwd": "${workspaceFolder}",
      "args": [
        "-log-level", "debug",
        "-dmx-channels", "16",
        "-dmx-read-port", "COM8",
        "-dmx-write-port", "COM7",
        "-config", "./configs/example.yaml",
        "-dmx-bridge=true"
      ]
    },
    {
      "name": "Launch no DMX",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/dmxweb/dmxweb.go",
      "cwd": "${workspaceFolder}",
      "args": [
        "-log-level", "debug",
        "-static", "static/example",
        "-config", "./configs/example2.yaml"
      ]
    },
    {
      "name": "Launch test config",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/dmxweb/dmxweb.go",
      "cwd": "${workspaceFolder}",
      "args": [
        "-log-level", "debug",
        "-config", "./configs/example.yaml"
      ]
    },
    {
      "name": "Launch WRITE",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/dmxweb/dmxweb.go",
      "cwd": "${workspaceFolder}",
      "args": [
        "-log-level", "debug",
        "-dmx-channels", "16",
        "-dmx-write-port", "COM7"
      ]
    },
    {
      "name": "Launch READ",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/dmxweb/dmxweb.go",
      "cwd": "${workspaceFolder}",
      "args": [
        "-log-level", "debug",
        "-dmx-channels", "16",
        "-dmx-read-port", "COM8"
      ]
    },
    {
      "name": "Launch WRITE&READ",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/dmxweb/dmxweb.go",
      "cwd": "${workspaceFolder}",
      "args": [
        "-log-level", "debug",
        "-static", "static/example",
        "-dmx-channels", "16",
        "-dmx-read-port", "COM8",
        "-dmx-write-port", "COM7",
        "-dmx-clear-on-quit=true"
      ]
    },
    {
      "name": "Launch Bridge to MOCK",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/dmxweb/dmxweb.go",
      "cwd": "${workspaceFolder}",
      "args": [
        "-log-level", "debug",
        "-dmx-channels", "16",
        "-dmx-read-port", "COM8",
        "-dmx-write-port", "MOCK",
        "-config", "./configs/example.yaml",
        "-dmx-bridge=true"
      ]
    },
    {
      "name": "Launch ALL but MOCKed",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/dmxweb/dmxweb.go",
      "cwd": "${workspaceFolder}",
      "args": [
        "-log-level", "debug",
        "-static", "static/example",
        "-dmx-channels", "16",
        "-dmx-read-port", "MOCK",
        "-dmx-write-port", "MOCK",
        "-config", "./configs/example2.yaml",
        "-dmx-bridge=true"
      ]
    }
  ]
}